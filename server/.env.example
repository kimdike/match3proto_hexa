# 서버 포트
PORT=8080

# JWT 서명 비밀키 — 실제 운영에서는 32자 이상 랜덤 문자열 (예: openssl rand -base64 48)
JWT_SECRET=changeme_local_dev_secret_replace_in_production

# CORS 허용 origin (콤마 분리). 비우면 모든 origin 허용 (개발용).
# 운영 시 반드시 정적 클라이언트 도메인만 허용.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:3000

# Supabase PostgreSQL connection string
# Supabase dashboard → Project Settings → Database → Connection string → URI 복사
# 예: postgresql://postgres.xxx:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=
